<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.local.tor</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/tor</string>
        <string>-f</string>
        <string>/opt/stack/tor/torrc</string>
    </array>
    <key>UserName</key>
    <string>_btcnode</string>
    <key>WorkingDirectory</key>
    <string>/opt/stack/tor</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>ExitTimeOut</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>/opt/stack/tor/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/opt/stack/tor/launchd.log</string>
</dict>
</plist>
