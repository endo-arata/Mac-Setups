<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.local.fulcrum</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/stack/bin/Fulcrum</string>
        <string>/opt/stack/fulcrum/fulcrum.conf</string>
    </array>
    <key>UserName</key>
    <string>_btcnode</string>
    <key>WorkingDirectory</key>
    <string>/opt/stack/fulcrum</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>ExitTimeOut</key>
    <integer>300</integer>
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>65536</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/opt/stack/fulcrum/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/opt/stack/fulcrum/launchd.log</string>
</dict>
</plist>
